{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadTrustedIngressParameter",
      "Effect": "Allow",
      "Action": "ssm:GetParameter",
      "Resource": "arn:aws-us-gov:ssm:us-gov-west-1:${aws:PrincipalAccount}:parameter/contract-review/*"
    },
    {
      "Sid": "ManageProjectWebFirewall",
      "Effect": "Allow",
      "Action": [
        "wafv2:AssociateWebACL",
        "wafv2:CreateIPSet",
        "wafv2:CreateWebACL",
        "wafv2:DeleteIPSet",
        "wafv2:DeleteLoggingConfiguration",
        "wafv2:DeleteWebACL",
        "wafv2:DisassociateWebACL",
        "wafv2:GetIPSet",
        "wafv2:GetLoggingConfiguration",
        "wafv2:GetWebACL",
        "wafv2:GetWebACLForResource",
        "wafv2:ListResourcesForWebACL",
        "wafv2:ListTagsForResource",
        "wafv2:PutLoggingConfiguration",
        "wafv2:TagResource",
        "wafv2:UntagResource",
        "wafv2:UpdateIPSet",
        "wafv2:UpdateWebACL"
      ],
      "Resource": [
        "arn:aws-us-gov:elasticloadbalancing:us-gov-west-1:${aws:PrincipalAccount}:loadbalancer/app/contract-review-*/*",
        "arn:aws-us-gov:wafv2:us-gov-west-1:${aws:PrincipalAccount}:regional/ipset/contract-review-*/*",
        "arn:aws-us-gov:wafv2:us-gov-west-1:${aws:PrincipalAccount}:regional/webacl/contract-review-*/*"
      ]
    },
    {
      "Sid": "ReadRegionalFirewallCatalog",
      "Effect": "Allow",
      "Action": [
        "wafv2:DescribeManagedRuleGroup",
        "wafv2:ListAvailableManagedRuleGroups",
        "wafv2:ListIPSets",
        "wafv2:ListLoggingConfigurations",
        "wafv2:ListWebACLs"
      ],
      "Resource": "*"
    }
  ]
}

# Requests use Vite's same-origin /api proxy or the built FastAPI application.
# VITE_API_BASE_URL is optional; leave unset for the local combined app.

# Optional, explicit offline presentation mode. Keep false for normal operation.
VITE_ENABLE_DEMO_MODE=false
# Required only when VITE_ENABLE_DEMO_MODE=true. Choose a local presentation password.
VITE_DEMO_PASSWORD=

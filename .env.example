# Copy to .env for local-only use. Never place real secrets in this file.
WORKSPACE_USERNAME=judge
WORKSPACE_PASSWORD=replace-with-a-random-password
DEMO_JWT_SECRET=replace-with-at-least-32-random-characters

BEDROCK_ENABLED=false
BEDROCK_MODEL_ID=openai.gpt-5.6-terra
AWS_REGION=us-gov-west-1

CLASSIFIER_ENABLED=true
OPENSEARCH_ENDPOINT=
OPENSEARCH_VECTOR_ENABLED=false
SECURITY_DOMAIN=demo
IDENTITY_MODE=demo
DEMO_IDENTITY_ENABLED=true

# Local persistence; ECS uses the encrypted Terraform-managed DynamoDB table.
WORKSPACE_DB_PATH=artifacts/workspace/lens.sqlite
WORKSPACE_TABLE=
# Optional administrator-approved mounted directory for batch sync.
WORKSPACE_IMPORT_ROOT=
